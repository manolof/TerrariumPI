# Slim image for Ludwig's enclosure. Derived from Dockerfile.bookworm.
# Removed: the sispmctl build, the 3rdparty libraries and their patches, bluez,
# lxml/ALSA build libraries, ftdi, sudo, the Java option.
# Added: raspivid from the old image, see the legacy_camera stage.
# Built by .github/workflows/ludwig-image.yml:
# docker buildx build --platform linux/arm/v7 -f Dockerfile.ludwig -t ghcr.io/manolof/terrariumpi:ludwig-<sha> .

# python builder, help keep image small
FROM python:3.11-bookworm AS python_builder
ENV PIP_DEFAULT_TIMEOUT=100 \
    # Allow statements and log messages to immediately appear
    PYTHONUNBUFFERED=1 \
    # disable a pip version check to reduce run-time & log-spam
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # cache is useless in docker image, so disable to reduce image size
    PIP_NO_CACHE_DIR=1 \
    # do not create __pycache__/ files
    PYTHONDONTWRITEBYTECODE=1
ENV PATH="/opt/venv/bin:$PATH"
RUN python -m venv /opt/venv
RUN pip install --upgrade pip==24.1.2 && pip install --upgrade wheel==0.43.0

COPY requirements.txt /

# The Raspberry Pi apt repository is added here and copied (/etc/apt) into the final image,
# which takes rpicam-apps-core and libraspberrypi-bin from it.
# Some strange DNS issues with installing PGP keys. keyserver.ubuntu.com => 185.125.188.26
# libglib2.0-dev is for building bluepy, which the sensor code still imports.
RUN  apt-get -o Acquire::ForceIPv4=true update \
  && apt-get -o Acquire::ForceIPv4=true install -y --no-install-recommends gnupg \
  && echo "deb http://raspbian.raspberrypi.org/raspbian/ bookworm main contrib non-free rpi" > /etc/apt/sources.list.d/raspberrypi.list \
  && echo "deb http://archive.raspberrypi.org/debian/ bookworm main" >> /etc/apt/sources.list.d/raspberrypi.list \
  && apt-key adv --keyserver 185.125.188.26 --recv-keys 9165938D90FDDD2E 82B129927FA3303E \
  && apt-get -o Acquire::ForceIPv4=true update \
  && apt-get -o Acquire::ForceIPv4=true install -y --no-install-recommends libglib2.0-dev make

# pip will exit with non 0 on a conflict, which stops the build. paho-mqtt and icalendar are no longer
# in requirements.txt, so their sed lines are gone.
RUN  pip install smbus==1.1.post2 --extra-index-url https://www.piwheels.org/simple \
  && pip install -r requirements.txt --extra-index-url https://www.piwheels.org/simple \
  && find /opt/venv -type d -name "test*" | xargs rm -rf  \
  && find /opt/venv -type d -name "__pycache__" | xargs rm -rf \
  && find /opt/venv -type d -name ".git" | xargs rm -rf \
  && find /opt/venv -type f -name "*.pyc" -delete

# Sourcecode cleanup and pre-prep
FROM python:3.11-bookworm AS sourcecode
WORKDIR /TerrariumPI
COPY . .
RUN rm -Rf .git .github .venv 3rdparty gui docs screenshots tests package*.json postcss.config.* rollup.config.js .env.* html-template.js requirements.txt yarn.lock

# The legacy camera tool, carried over from the image it works in. The Pi runs the legacy camera stack (start_x=1 in
# its boot config): rpicam-vid finds no camera there, and bookworm packages have no raspivid. This stage only gives
# files: RUN does not go through the image's ENTRYPOINT, so its run.sh and CMD never run.
# Collected: the binary, the userland libraries by name (some are loaded by name at run time, so ldd alone misses
# them), then whatever those need, until nothing new turns up. glibc and libm stay out: they come from the final image.
FROM theyosh/terrariumpi:4.16.0-buster AS legacy_camera
RUN set -eu; \
    out=/opt/legacy-camera; \
    mkdir -p "$out/lib"; \
    cp -L /usr/bin/raspivid "$out/raspivid"; \
    for dir in /opt/vc/lib /usr/lib/arm-linux-gnueabihf; do \
      for name in libmmal libbcm_host libvcos libvchiq_arm libvcsm libcontainers; do \
        for lib in "$dir/$name"*.so*; do \
          if [ -f "$lib" ] && [ ! -e "$out/lib/${lib##*/}" ]; then cp -L "$lib" "$out/lib/"; fi; \
        done; \
      done; \
    done; \
    count=-1; \
    while [ "$count" != "$(ls "$out/lib" | wc -l)" ]; do \
      count="$(ls "$out/lib" | wc -l)"; \
      for file in "$out/raspivid" "$out/lib/"*; do \
        LD_LIBRARY_PATH="$out/lib" ldd "$file" | awk '$2 == "=>" && $3 ~ /^\// {print $3}' | while read -r lib; do \
          case "${lib##*/}" in \
            ld-linux*|libc.so*|libm.so*|libdl.so*|libpthread.so*|librt.so*|libresolv.so*|libnsl.so*|libutil.so*) ;; \
            *) if [ ! -e "$out/lib/${lib##*/}" ]; then cp -L "$lib" "$out/lib/"; fi ;; \
          esac; \
        done; \
      done; \
    done; \
    ls -l "$out/lib"; \
    LD_LIBRARY_PATH="$out/lib" ldd "$out/raspivid"; \
    test -e "$out/lib/libmmal_core.so"; \
    test -e "$out/lib/libbcm_host.so"; \
    if LD_LIBRARY_PATH="$out/lib" ldd "$out/raspivid" | grep "not found"; then exit 1; fi

# actual image
FROM python:3.11-slim-bookworm AS finalimage
ARG GITHUB_SHA="development"
ENV PIP_DEFAULT_TIMEOUT=100 \
    # Allow statements and log messages to immediately appear
    PYTHONUNBUFFERED=1 \
    # disable a pip version check to reduce run-time & log-spam
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # cache is useless in docker image, so disable to reduce image size
    PIP_NO_CACHE_DIR=1 \
    # do not create __pycache__/ files
    PYTHONDONTWRITEBYTECODE=1
ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/opt/venv/bin:$PATH"

COPY --from=python_builder /etc/apt /etc/apt
COPY --from=python_builder /opt/venv /opt/venv
COPY --from=sourcecode /TerrariumPI /TerrariumPI
COPY --from=legacy_camera /opt/legacy-camera /opt/legacy-camera

# pigpiod: GPIO daemon (run.sh starts it). pigpio-tools: pigs, which the switch steps use to read the dimmer pin.
# The `pigpio` package would also pull in python3 and the -dev libraries. ffmpeg and rpicam-apps-core (rpicam-vid): camera stream.
# libglib2.0-0: bluepy-helper links to it, and bluez (which used to pull it in) is gone.
# The numpy/OpenCV runtime libraries stay. ftdi, xslt and sudo are gone.
# No cv2 symlink: it pointed at /usr/lib/python3/dist-packages/cv2*.so from the apt python3-opencv package, which
# is not installed, so it dangled; cv2 comes from opencv-python-headless in the venv (smoke.py imports it).
RUN  apt-get -o Acquire::ForceIPv4=true update \
  && apt-get -o Acquire::ForceIPv4=true full-upgrade -y --no-install-recommends \
  && apt-get -o Acquire::ForceIPv4=true install -y --no-install-recommends netcat-openbsd procps libglib2.0-0 pigpiod pigpio-tools ffmpeg libssl1.1 libatlas3-base libopenblas0 libgfortran5 libwebpdemux2 libraspberrypi-bin rpicam-apps-core \
  && apt-get --purge autoremove -y \
  && apt-get autoclean \
  && rm -rf /var/lib/apt/lists/* \
  && find /var/log/ -type f -delete \
  && find /var/cache/ -type f -delete

# rpilive_webcam.py looks for /usr/bin/raspivid, and rpilive_webcam.sh finds it on the PATH. The old libraries are for
# this one process only: /opt/legacy-camera/lib is not in the loader's search path, so nothing else picks them up.
RUN  printf '#!/bin/sh\nLD_LIBRARY_PATH=/opt/legacy-camera/lib exec /opt/legacy-camera/raspivid "$@"\n' > /usr/bin/raspivid \
  && chmod 755 /usr/bin/raspivid

WORKDIR /TerrariumPI
# Set git version in a temp file
RUN echo "${GITHUB_SHA}" > .gitversion && echo '[ ! -z "$TERM" -a -r /TerrariumPI/motd.sh ] && /TerrariumPI/motd.sh' >> /etc/bash.bashrc

HEALTHCHECK --interval=180s --timeout=5s --start-period=120s CMD python contrib/docker_health.py

ENTRYPOINT ["/bin/bash", "/TerrariumPI/run.sh"]
CMD ["/opt/venv/bin/python", "/TerrariumPI/terrariumPI.py"]
